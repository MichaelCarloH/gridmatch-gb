# GridMatch API — local demo defaults; no secrets are required.
GRIDMATCH_DATA_DIR=./data
GRIDMATCH_ARTIFACT_DIR=./artifacts
GRIDMATCH_DEMO_MODE=true
GRIDMATCH_CORS_ORIGINS=http://localhost:3000
GRIDMATCH_MAX_RESPONSE_ROWS=1000
GRIDMATCH_MODEL_CACHE_SIZE=8
GRIDMATCH_UPLOAD_MAX_BYTES=2000000

# Next.js proxies local /api calls to this server-only API address.
GRIDMATCH_API_INTERNAL_URL=http://127.0.0.1:8000

# Set this only when the browser must call an externally hosted API directly.
# NEXT_PUBLIC_GRIDMATCH_API_URL=https://api.example.com

# Optional read-only browser mode. The same mode can be previewed with
# `?data=static`; normal operation falls back automatically if a GET endpoint
# is unavailable.
# NEXT_PUBLIC_GRIDMATCH_FORCE_STATIC=true
